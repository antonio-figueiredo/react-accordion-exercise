# Dependências (nunca envie essa pasta, ela é recriada com 'npm install')
node_modules/
jspm_packages/
web_modules/

# Pastas de Build / Produção
build/
dist/
out/

# Arquivos de variáveis de ambiente (contêm chaves secretas)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs de erro do npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pastas de testes e cobertura (se houver)
coverage/
.nyc_output/

# Arquivos temporários do Sistema Operacional
.DS_Store
Thumbs.db

# Configurações de editores de código (opcional, mas recomendado)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

